{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd other/ai-learning-platform/frontend && npm install",
  "buildCommand": "cd other/ai-learning-platform/frontend && npm run build",
  "outputDirectory": "other/ai-learning-platform/frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://<PUBLIC-BACKEND-URL>/api/$1" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
