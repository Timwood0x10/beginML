[Unit]
Description=AI Learning Platform Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__PROJECT_ROOT__/backend
ExecStart=__UV_PATH__ run uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=NOTES_ROOT=__PROJECT_ROOT__
Environment=PATH=__UV_DIR__:/usr/local/bin:/usr/bin:/bin

# Optional resource limits – uncomment to enable
# MemoryLimit=200M
# CPUQuota=50%

[Install]
WantedBy=multi-user.target