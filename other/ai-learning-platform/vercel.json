{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd frontend && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://${BACKEND_URL}/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "https://${BACKEND_URL}/assets/$1"
    },
    {
      "source": "/raw/(.*)",
      "destination": "https://${BACKEND_URL}/raw/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
